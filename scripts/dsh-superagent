#!/usr/bin/env python3
"""Manage a local dsh-superagent service (one DSH profile, default `superagent`) without affecting other tmux sessions.

`status`, `start`, and `restart` exit 0 while the service runs normally; 1 when it is stopped, duplicated, unreachable, or
reporting a runtime error, which `restart` may fix; 2 when it runs while a component such as a Source reports an error;
and 3 when it runs and waits for setup. A restart fixes neither 2 nor 3: they need a person.
"""

import argparse
from contextlib import closing
import fcntl
import getpass
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import shutil
import signal
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = Path(__file__).resolve().parent.parent
ARTIFACTS = Path(os.environ['DSH_SUPERAGENT_ARTIFACTS']).resolve() if os.environ.get('DSH_SUPERAGENT_ARTIFACTS') else ROOT / '.artifacts'
CONTROL = ARTIFACTS / 'control'
KEEP_LOGS = 20


def control(profile):
    """Return the control directory for `profile`, creating it if needed."""
    directory = CONTROL / 'profiles' / profile
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def stopped(profile):
    """Return whether `profile` was intentionally stopped."""
    return (control(profile) / 'manually-stopped').exists()


def serves(name, args, profile):
    """Return whether command-line arguments belong to the main DSH service process for `profile`."""
    words, matched, value = [], False, False
    for word in args[1:]:
        if value:
            matched, value = matched or word == profile, False
        elif word == '--profile':
            value = True
        elif word == '--profile=' + profile:
            matched = True
        elif not word.startswith('-'):
            words.append(word)
    if name == 'DeepSeek Harness':
        launcher = any(word.endswith('/@deepseek-ai/dsh-desktop-host/lib/cli.js') for word in args)
    elif name == 'node':
        head = args[1:next((index for index, word in enumerate(args) if word.startswith('--profile')), len(args))]
        launcher = any(Path(word).name in ('dsh', 'dsh.js', 'dsh.mjs') or '/dsh-cli/' in word for word in head)
    else:
        launcher = name == 'dsh'
    return launcher and matched and 'plugin' not in words


def ps(*options, check=False):
    """Yield `(pid, comm, args)` tuples from `ps`; arguments are split on whitespace, so paths with spaces become several words and only `--profile` and subcommands are inspected."""
    result = subprocess.run(['ps', '-ww', *options, '-o', 'pid=,ucomm=,args='], check=check, capture_output=True, text=True)
    for line in result.stdout.splitlines():
        match = re.match(r'\s*(\d+)\s+(DeepSeek Harness|node|dsh)\s+(.+)', line)
        if match:
            yield int(match[1]), match[2], match[3].split()


def running(pid, profile):
    """Return whether `pid` is currently running the DSH service for `profile` (`ps -p` returns nothing once exited)."""
    return any(found == pid and serves(name, args, profile) for found, name, args in ps('-p', str(pid)))


def processes(profile):
    """Return PIDs of all running DSH service processes for `profile`, including instances started outside this script and the recorded `service.pid` while still running."""
    found = [pid for pid, name, args in ps('-ax', check=True) if serves(name, args, profile)]
    try:
        pid = int((control(profile) / 'service.pid').read_text())
    except (OSError, ValueError):
        return found
    return found + [pid] if pid not in found and running(pid, profile) else found


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def management_url(url):
    parsed = urllib.parse.urlsplit(url)
    if (parsed.scheme != 'http' or parsed.hostname not in ('127.0.0.1', 'localhost')
            or parsed.username is not None or parsed.path not in ('', '/') or parsed.query or parsed.fragment):
        raise ValueError('--url must be an http://127.0.0.1 or http://localhost origin')
    return f'http://127.0.0.1:{parsed.port or 80}'


def request(url, route, body=None, token=None, instance=None, timeout=None):
    headers = {'x-orchestrator-request': '1'}
    if instance:
        headers['x-orchestrator-instance'] = instance
    if token:
        headers['Authorization'] = 'Bearer ' + token
    data = None
    if body is not None:
        headers['Content-Type'] = 'application/json'
        data = json.dumps(body, ensure_ascii=False).encode('utf-8')
    query = urllib.request.Request(management_url(url) + '/orchestrator/api/' + route, data=data, headers=headers)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
    with opener.open(query, timeout=timeout or (5 if body is not None else 2)) as response:
        return json.load(response)


def operator_token(args):
    if not args.token_file:
        if not sys.stdin.isatty():
            raise RuntimeError('Set --token-file when running without a terminal.')
        return getpass.getpass('Superagent operator token: ').strip()
    fd = os.open(args.token_file, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'r', encoding='ascii') as file:
        metadata = os.fstat(file.fileno())
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
            raise RuntimeError('The token file must be a private regular file owned by the operator.')
        return file.read(256).strip()


def profile_state_dir(profile):
    home = Path(os.environ.get('DSH_HOME', '').strip() or Path.home() / '.dsh').expanduser()
    patch = home / 'profiles' / profile / 'cordis.patch.yml'
    if not patch.is_file():
        return None
    active = False
    for line in patch.read_text(encoding='utf-8-sig').splitlines():
        if line.startswith('- '):
            active = re.fullmatch(r"-\s+id:\s*['\"]?dsh-superagent['\"]?\s*(?:#.*)?", line) is not None
        match = re.match(r'\s+stateDir:\s*(.+)', line) if active else None
        if not match:
            continue
        value = re.split(r'\s+#', match[1], maxsplit=1)[0].strip()
        home_path = re.fullmatch(r"!!js\s+dshHomePath\(\s*(['\"])([^'\"\\]+)\1\s*\)", value)
        if home_path:
            return home / home_path[2]
        if len(value) > 1 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        candidate = Path(value)
        if candidate.is_absolute():
            return candidate
        raise ValueError('Unsupported stateDir expression in profile patch. Use --state-dir.')
    return None


def discover(state_dir, timeout=0.6):
    path = Path(state_dir) / 'runtime-endpoint.json'
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'r', encoding='utf-8') as file:
        meta = os.fstat(file.fileno())
        if not stat.S_ISREG(meta.st_mode) or meta.st_uid != os.getuid() or meta.st_mode & 0o077:
            raise ValueError('runtime-endpoint.json must be a private regular file owned by the operator.')
        endpoint = json.loads(file.read(4096))
    if not isinstance(endpoint, dict):
        raise ValueError('Malformed runtime-endpoint.json.')
    pid, port, instance = endpoint.get('pid'), endpoint.get('port'), endpoint.get('instanceId')
    if (endpoint.get('version') != 1 or endpoint.get('host') != '127.0.0.1'
            or type(pid) is not int or pid <= 0 or type(port) is not int or not 0 < port < 65536
            or not isinstance(instance, str) or not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', instance)):
        raise ValueError('Malformed runtime-endpoint.json.')
    os.kill(pid, 0)
    url = f'http://127.0.0.1:{port}'
    health = request(url, 'health', timeout=timeout)
    if not isinstance(health, dict) or health.get('ok') is not True or health.get('pid') != pid or health.get('instanceId') != instance:
        raise RuntimeError('Superagent endpoint changed before discovery completed.')
    return url, instance, health


def manage(args, route, body):
    token = operator_token(args)
    if not re.fullmatch(r'[A-Za-z0-9_-]{32,128}', token):
        raise RuntimeError('The operator token has an invalid format.')
    deadline = time.monotonic() + 3
    while True:
        try:
            if args.discovery:
                url, instance, _ = discover(args.discovery, min(0.6, max(0.05, deadline - time.monotonic())))
                receipt = request(url, route, body, token, instance, max(0.05, deadline - time.monotonic()))
            else:
                receipt = request(args.url, route, body, token)
            break
        except urllib.error.HTTPError as error:
            detail = json.load(error) if error.headers.get_content_type() == 'application/json' else {}
            if not isinstance(detail, dict):
                detail = {}
            if not (args.discovery and (error.code == 503 or error.code == 409 and detail.get('code') == 'instance_mismatch')
                    and time.monotonic() < deadline):
                raise RuntimeError(f"HTTP {error.code}: {detail.get('error', str(error))}") from None
        except (OSError, RuntimeError, json.JSONDecodeError):
            if not args.discovery or time.monotonic() >= deadline:
                raise
        time.sleep(min(0.15, max(0, deadline - time.monotonic())))
    print(json.dumps(receipt, ensure_ascii=False, indent=2))
    return 0


def init_token(output):
    token = secrets.token_urlsafe(32)
    with Path(output).open('x', encoding='ascii') as file:
        file.write(token + '\n')
    print(hashlib.sha256(token.encode('ascii')).hexdigest())
    return 0


def backup(state_dir, output):
    source = Path(state_dir).resolve() / 'orchestrator.sqlite'
    target = Path(output).absolute()
    if target.exists() or target.is_symlink():
        raise RuntimeError('The backup output already exists.')
    fd, temporary = tempfile.mkstemp(prefix='.superagent-backup-', dir=target.parent)
    os.close(fd)
    try:
        deadline = time.monotonic() + 30

        def progress(_status, _remaining, _total):
            if time.monotonic() >= deadline:
                raise RuntimeError('SQLite backup timed out. Try again when writes settle.')

        with (closing(sqlite3.connect(source.as_uri() + '?mode=ro', uri=True, timeout=5)) as origin,
              closing(sqlite3.connect(temporary)) as destination):
            origin.backup(destination, pages=256, progress=progress)
            if destination.execute('PRAGMA quick_check').fetchone() != ('ok',):
                raise RuntimeError('The SQLite snapshot did not pass quick_check.')
        with open(temporary, 'rb') as snapshot:
            os.fsync(snapshot.fileno())
        os.link(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)
    print(str(target))
    return 0


def state(url, token=None):
    """Fetch health and setup status from the management API, or return None if unreachable."""
    try:
        value = request(url, 'state', token=token)
        # Keys omitted by another version read as empty so the service is not mistaken for unreachable.
        health, setup = value.get('health') or {}, value.get('setup') or {}
        entries = {name: entry if isinstance(entry, dict) else {} for name, entry in health.items()}
        return {'health': {name: entry.get('state') for name, entry in entries.items()},
                'errors': {name: str(entry.get('detail', '')) for name, entry in entries.items() if entry.get('state') == 'error'},
                'setup': setup.get('problem'), 'feishu': setup.get('feishuProblem')}
    except (OSError, ValueError, AttributeError):
        return None


PART_ERROR = 2
SETUP_WAITS = 3


def runtime_up(current):
    """Return whether the runtime is ready or paused awaiting operator action; a component still starting (such as history recovery) does not hold this up."""
    return current is not None and current['health'].get('runtime') in ('ready', 'paused')


def part_errors(current):
    """Return non-runtime components that are in an error state."""
    return {name: detail for name, detail in sorted(current['errors'].items()) if name != 'runtime'}


def outcome(pids, current):
    """Compute the CLI exit code from running PIDs and management API state."""
    if len(pids) != 1 or not runtime_up(current):
        return 1
    if current['setup']:
        return SETUP_WAITS
    # A component's lasting error, unlike a Feishu bot check that failed during setup, requires operator action.
    return PART_ERROR if part_errors(current) else 0


def status(args):
    pids = processes(args.profile)
    url = args.url
    current = None
    if args.discovery:
        try:
            url, _, health = discover(args.discovery)
            pids = [health['pid']] if not pids else pids
            token = operator_token(args) if args.token_file else None
            current = state(url, token) or {'health': {'runtime': 'ready'}, 'errors': {}, 'setup': None, 'feishu': None}
        except (OSError, RuntimeError, ValueError):
            pass
    elif pids:
        current = state(url, operator_token(args) if args.token_file else None)
    print(json.dumps({'pids': pids, 'cwd': str(ROOT), 'url': url,
                      'manually_stopped': stopped(args.profile), 'health': current and current['health'],
                      'errors': current and current['errors'], 'setup': current and current['setup'],
                      'feishu': current and current['feishu']}, ensure_ascii=False, indent=2))
    return outcome(pids, current)


def stop(args, intentional=True):
    """Stop the service gracefully, recording a manual stop marker when `intentional` is True."""
    pids = processes(args.profile)
    if len(pids) > 1:
        raise RuntimeError('Multiple dsh-superagent processes found; refusing to choose one.')
    # Write the stop marker before waiting so monitors respect the intentional stop even if graceful shutdown times out.
    if intentional:
        (control(args.profile) / 'manually-stopped').write_text(time.strftime('%Y-%m-%dT%H:%M:%S%z') + '\n')
    for pid in pids:
        if not running(pid, args.profile):
            continue
        try:
            os.kill(pid, signal.SIGINT)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + args.stop_timeout
    while any(running(pid, args.profile) for pid in pids):
        if time.monotonic() >= deadline:
            raise RuntimeError('Graceful stop timed out; no forced kill was sent. Check status.')
        time.sleep(0.5)
    (control(args.profile) / 'service.pid').unlink(missing_ok=True)
    print('dsh-superagent stopped. Automatic recovery is paused until start/restart.' if intentional else 'dsh-superagent stopped.')


def prune_logs(profile):
    """Retain only the newest `KEEP_LOGS` log files for `profile`."""
    name = re.compile(re.escape(f'dsh-superagent-{profile}-') + r'\d{8}-\d{6}-\d+\.log')
    logs = sorted((path for path in ARTIFACTS.iterdir() if name.fullmatch(path.name)), key=lambda path: path.stat().st_mtime)
    for path in logs[:-KEEP_LOGS]:
        path.unlink(missing_ok=True)


def start(args):
    session = 'dsh-' + args.profile
    pids = processes(args.profile)
    if len(pids) > 1:
        raise RuntimeError('Multiple dsh-superagent processes found; refusing to start another.')
    if not pids:
        dsh = shutil.which('dsh')
        if not dsh or not shutil.which('tmux'):
            raise RuntimeError('Both dsh and tmux must be on PATH.')
        exists = subprocess.run(['tmux', 'has-session', '-t', '=' + session],
                                capture_output=True).returncode == 0
        if args.discovery:
            try: discover(args.discovery)
            except (OSError, RuntimeError): pass
            else: raise RuntimeError('Superagent already answers through this state directory.')
        if state(args.url) is not None:
            raise RuntimeError('An existing orchestrator answers at this URL; refusing duplicate startup.')
        stamp = time.strftime('%Y%m%d-%H%M%S')
        log = ARTIFACTS / f'dsh-superagent-{args.profile}-{stamp}-{os.getpid()}.log'
        log.touch()
        prune_logs(args.profile)
        # `exec` replaces the shell so the pane PID printed by tmux is the DSH service process itself.
        command = ('umask 077; exec ' + shlex.join([dsh, '--profile', args.profile, '--no-open'])
                   + ' >> ' + shlex.quote(str(log)) + ' 2>&1')
        # Reuse an existing tmux session without disturbing other windows.
        target = ['new-window', '-t', '=' + session + ':'] if exists else ['new-session', '-s', session]
        pane = subprocess.run(['tmux', *target, '-d', '-P', '-F', '#{pane_pid}', '-n', 'server', '-c', str(ROOT), command],
                              check=True, capture_output=True, text=True).stdout.strip()
        if pane.isdigit():
            (control(args.profile) / 'service.pid').write_text(pane + '\n')
        print('Log: ' + str(log), flush=True)
    else:
        (control(args.profile) / 'service.pid').write_text(f'{pids[0]}\n')
        print(f'dsh-superagent already running (PID {pids[0]}); no duplicate started.', flush=True)
    (control(args.profile) / 'manually-stopped').unlink(missing_ok=True)
    deadline = time.monotonic() + args.timeout
    while time.monotonic() < deadline:
        if args.discovery:
            try:
                endpoint_url, _, _ = discover(args.discovery)
                current = state(endpoint_url, operator_token(args) if args.token_file else None) or {'health': {'runtime': 'ready'}, 'errors': {}, 'setup': None, 'feishu': None}
            except (OSError, RuntimeError, json.JSONDecodeError):
                current = None
        else:
            current = state(args.url, operator_token(args) if args.token_file else None)
        if processes(args.profile) and runtime_up(current):
            code = status(args)
            if current['setup']:
                print('dsh-superagent is waiting for setup: ' + str(current['setup'].get('detail', '')))
                print('Open the URL DSH printed in the log, then the dsh-superagent overview.')
            if current['feishu']:
                print('dsh-superagent runs without Feishu: ' + str(current['feishu'].get('detail', '')))
                print('Fix it on the Feishu card of the Source settings.')
            for name, detail in part_errors(current).items():
                print(f'{name} reports an error, which a restart does not fix: {detail}')
            return code
        time.sleep(1)
    status(args)
    raise RuntimeError('Startup health check timed out; inspect the log. Any running process was left intact.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['start', 'stop', 'restart', 'status', 'pause', 'resume', 'submit', 'backup', 'init-token'])
    parser.add_argument('--profile', default=os.environ.get('DSH_SUPERAGENT_PROFILE') or 'superagent',
                        help='DSH profile that loads dsh-superagent; its tmux session is dsh-<profile>.')
    parser.add_argument('--url', default=os.environ.get('DSH_SUPERAGENT_URL') or None,
                        help='Health-check URL; override after changing the profile port.')
    parser.add_argument('--timeout', type=float, default=60, help='Startup timeout in seconds.')
    parser.add_argument('--stop-timeout', type=float, default=300,
                        help='Graceful shutdown timeout in seconds; running Executor Sessions finish their step first.')
    parser.add_argument('--respect-stop', action='store_true',
                        help='For monitoring: never start/restart after an intentional stop.')
    parser.add_argument('--token-file', help='Private operator token file. Otherwise prompt on the terminal.')
    parser.add_argument('--request-id', help='Stable unique request ID. Reuse it when retrying a submit.')
    parser.add_argument('--desk', help='Desk label for a local submission.')
    parser.add_argument('--title', help='Explicit deliverable title for a local submission.')
    parser.add_argument('--workspace-name', help='Short English worktree name for a local submission.')
    parser.add_argument('--file', help='UTF-8 submission body file, or - for stdin.')
    parser.add_argument('--state-dir', help='Superagent state directory for discovery or SQLite backup.')
    parser.add_argument('--output', help='New file for backup or init-token.')
    args = parser.parse_args()
    if args.timeout <= 0 or args.stop_timeout <= 0:
        parser.error('--timeout and --stop-timeout must be positive')
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.-]*', args.profile):
        parser.error('--profile must be a DSH profile name')
    os.umask(0o077)
    if args.action == 'init-token':
        if not args.output:
            parser.error('init-token requires --output')
        return init_token(args.output)
    if args.action == 'backup':
        if not args.state_dir or not args.output:
            parser.error('backup requires --state-dir and --output')
        return backup(args.state_dir, args.output)
    args.discovery = (args.state_dir or profile_state_dir(args.profile)) if args.url is None else None
    args.url = management_url(args.url or 'http://127.0.0.1:3082')
    if args.action == 'pause':
        return manage(args, 'executor/pause', {'paused': True})
    if args.action == 'resume':
        return manage(args, 'resume', {})
    if args.action == 'submit':
        if not all((args.request_id, args.desk, args.title, args.workspace_name, args.file)):
            parser.error('submit requires --request-id, --desk, --title, --workspace-name and --file')
        if args.file == '-':
            text = sys.stdin.read(60_001)
        else:
            with Path(args.file).open(encoding='utf-8') as file:
                text = file.read(60_001)
        if len(text) > 60_000:
            raise RuntimeError('The request body exceeds 60,000 characters.')
        return manage(args, 'local/submit', {'request_id': args.request_id, 'desk': args.desk,
                      'title': args.title, 'workspace_name': args.workspace_name, 'text': text})
    with (control(args.profile) / 'operation.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Another dsh-superagent control operation is in progress.') from None
        if args.respect_stop and args.action in ('start', 'restart') and stopped(args.profile):
            print('Intentional stop is active; automatic recovery skipped.')
            return 0
        if args.action == 'status':
            return status(args)
        if args.action in ('stop', 'restart'):
            # Only a stop keeps automatic recovery off; a restart whose stop timed out leaves it on.
            stop(args, intentional=args.action == 'stop')
        if args.action in ('start', 'restart'):
            return start(args)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError, sqlite3.Error, subprocess.CalledProcessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
